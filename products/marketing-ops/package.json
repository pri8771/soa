{
  "name": "@marketing-ops/root",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first B2B marketing project management and social automation platform",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "clean": "turbo run clean && rimraf .turbo node_modules",
    "dev": "pnpm build:packages && turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint && node scripts/check-boundaries.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "rimraf": "6.1.3",
    "turbo": "2.10.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0"
  }
}
