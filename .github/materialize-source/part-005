from __future__ import annotations

from fastapi import APIRouter, Depends, HTTPException, status
from sqlalchemy import func, select

from app.api.deps import Context, DbSession, RequestContext, require_role
from app.models import Document, ProcessDefinition, ReviewTask, Stream
from app.schemas import StreamCreate, StreamRead, StreamUpdate
from app.services.audit import record_audit

router = APIRouter(prefix="/streams", tags=["streams"])


def _stream_response(db: DbSession, stream: Stream) -> StreamRead:
    document_count = (
        db.scalar(select(func.count(Document.id)).where(Document.stream_id == stream.id)) or 0
    )
    review_count = (
        db.scalar(
            select(func.count(ReviewTask.id))
            .join(Document, ReviewTask.document_id == Document.id)
            .where(
                Document.stream_id == stream.id,
                ReviewTask.status.in_(["unassigned", "assigned", "in_review"]),
            )
        )
        or 0
    )
    response = StreamRead.model_validate(stream)
    response.document_count = document_count
    response.review_count = review_count
    return response


@router.get("", response_model=list[StreamRead])
def list_streams(context: Context, db: DbSession) -> list[StreamRead]:
    streams = db.scalars(
        select(Stream)
        .where(Stream.organization_id == context.organization.id)
        .order_by(Stream.status, Stream.name)
    ).all()
    return [_stream_response(db, stream) for stream in streams]


@router.post("", response_model=StreamRead, status_code=status.HTTP_201_CREATED)
def create_stream(
    payload: StreamCreate,
    db: DbSession,
    context: RequestContext = Depends(require_role("bucket_admin")),
) -> StreamRead:
    process = db.get(ProcessDefinition, payload.process_id)
    if not process or process.organization_id != context.organization.id:
        raise HTTPException(status_code=404, detail="Process not found")
    duplicate = db.scalar(
        select(Stream).where(
            Stream.organization_id == context.organization.id,
            Stream.slug == payload.slug,
        )
    )
    if duplicate:
        raise HTTPException(status_code=409, detail="Stream slug already exists")
    stream = Stream(
        organization_id=context.organization.id,
        **payload.model_dump(),
    )
    db.add(stream)
    db.flush()
    record_audit(
        db,
        organization_id=context.organization.id,
        actor_user_id=context.user.id,
        action="stream.created",
        entity_type="stream",
        entity_id=stream.id,
        payload={"name": stream.name, "location": stream.location},
    )
    db.commit()
    db.refresh(stream)
    return _stream_response(db, stream)


@router.get("/{stream_id}", response_model=StreamRead)
def get_stream(stream_id: str, context: Context, db: DbSession) -> StreamRead:
    stream = db.get(Stream, stream_id)
    if not stream or stream.organization_id != context.organization.id:
        raise HTTPException(status_code=404, detail="Stream not found")
    return _stream_response(db, stream)


@router.patch("/{stream_id}", response_model=StreamRead)
def update_stream(
    stream_id: str,
    payload: StreamUpdate,
    db: DbSession,
    context: RequestContext = Depends(require_role("bucket_admin")),
) -> StreamRead:
    stream = db.get(Stream, stream_id)
    if not stream or stream.organization_id != context.organization.id:
        raise HTTPException(status_code=404, detail="Stream not found")
    changes = payload.model_dump(exclude_unset=True)
    for key, value in changes.items():
        setattr(stream, key, value)
    record_audit(
        db,
        organization_id=context.organization.id,
        actor_user_id=context.user.id,
        action="stream.updated",
        entity_type="stream",
        entity_id=stream.id,
        payload={"fields": sorted(changes)},
    )
    db.commit()
    db.refresh(stream)
    return _stream_response(db, stream)
