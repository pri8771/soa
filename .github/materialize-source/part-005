    if int(document.validation_summary.get("error_count", 0) or 0) > 0:
        raise HTTPException(
            status_code=status.HTTP_409_CONFLICT,
            detail=(
                "Validation errors must be resolved before approval. "
                "A supervisor may use the audited override action when the exception is accepted."
            ),
        )
    _complete_approval(
        db=db,
        context=context,
        document=document,
        action="document.approved",
    )
    db.commit()
    return get_document(document_id, context, db)


