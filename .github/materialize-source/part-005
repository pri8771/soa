,
    db: DbSession,
    context: RequestContext = Depends(require_role("reviewer")),
) -> DocumentDetail:
    document = _get_document(db, context, document_id)
    if not document.review_task:
        document.review_task = ReviewTask(
            organization_id=context.organization.id,
            document_id=document.id,
        )
    task = document.review_task
    if task.assigned_user_id and task.assigned_user_id != context.user.id:
        raise HTTPException(status_code=409, detail="Document is assigned to another reviewer")
    task.assigned_user_id = context.user.id
    task.status = "in_review"
    task.started_at = task.started_at or datetime.now(UTC)
    document.status = "in_review"
    record_audit(
        db,
        organization_id=context.organization.id,
        actor_user_id=context.user.id,
        action="review.claimed",
        entity_type="document",
        entity_id=document.id,
    )
    db.commit()
    return get_document(document_id, context, db)


