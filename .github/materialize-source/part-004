def _set_json_path(root: dict, path: str, value: str | None) -> None:
    parts = re.split(r"\.(?![^\[]*\])", path)
    cursor: object = root
    for index, part in enumerate(parts):
        match = re.fullmatch(r"([a-zA-Z0-9_]+)\[(\d+)\]", part)
        is_last = index == len(parts) - 1
        if match:
            key, list_index_raw = match.groups()
            list_index = int(list_index_raw)
            if not isinstance(cursor, dict):
                raise ValueError("Invalid field path")
            values = cursor.setdefault(key, [])
            if not isinstance(values, list):
                raise ValueError("Invalid field path")
            while len(values) <= list_index:
                values.append({})
            if is_last:
                values[list_index] = value
                return
            cursor = values[list_index]
            continue
        if not isinstance(cursor, dict):
            raise ValueError("Invalid field path")
        if is_last:
            cursor[part] = value
            return
        cursor = cursor.setdefault(part, {})


@router.get("", response_model=DocumentListResponse)
def list_documents(
    context: Context,
    db: DbSession,
    stream_id: str | None = None,
    document_status: Annotated[str | None, Query(alias="status")] = None,
    search: str | None = None,
    page: int = Query(default=1, ge=1),
    page_size: int = Query(default=25, ge=1, le=100),
) -> DocumentListResponse:
    conditions = [Document.organization_id == context.organization.id]
    if stream_id:
        conditions.append(Document.stream_id == stream_id)
    if document_status:
        statuses = [value.strip() for value in document_status.split(",") if value.strip()]
        conditions.append(Document.status.in_(statuses))
    if search:
        term = f"%{search.lower()}%"
        conditions.append(
            or_(
                func.lower(Document.filename).like(term),
                func.lower(Document.canonical_data["po_number"].as_string()).like(term),
                func.lower(Document.canonical_data["customer_name"].as_string()).like(term),
            )
        )

    total = db.scalar(select(func.count(Document.id)).where(*conditions)) or 0
    documents = db.scalars(
        select(Document)
        .where(*conditions)
        .order_by(Document.created_at.desc())
        .offset((page - 1) * page_size)
        .limit(page_size)
    ).all()
    return DocumentListResponse(
        items=[_document_read(document) for document in documents],
        total=total,
        page=page,
        page_size=page_size,
