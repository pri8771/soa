    file: UploadFile = File(...),
) -> CatalogRead:
    catalog = _get_catalog(db, context, catalog_id)
    content = file.file.read(10 * 1024 * 1024 + 1)
    if len(content) > 10 * 1024 * 1024:
        raise HTTPException(status_code=413, detail="Catalog file exceeds 10 MB")
    try:
        text = content.decode("utf-8-sig")
        reader = csv.DictReader(io.StringIO(text))
    except UnicodeDecodeError as exc:
        raise HTTPException(status_code=422, detail="Catalog must be UTF-8 CSV") from exc
    imported = 0
    for row in reader:
        normalized = {key.strip(): value.strip() for key, value in row.items() if key}
        external_id = (
            normalized.get("external_id") or normalized.get("id") or normalized.get("customer_id")
