@router.patch("/{document_id}/fields/{field_id}", response_model=DocumentDetail)
def update_field(
    document_id: str,
    field_id: str,
    payload: FieldUpdate,
    db: DbSession,
    context: RequestContext = Depends(require_role("reviewer")),
) -> DocumentDetail:
    document = _get_document(db, context, document_id)
    field = db.get(ExtractedField, field_id)
    if (
        not field
        or field.document_id != document.id
        or field.organization_id != context.organization.id
    ):
        raise HTTPException(status_code=404, detail="Field not found")
    before = field.normalized_value
    field.normalized_value = payload.normalized_value
    field.corrected_by_user_id = context.user.id
    field.corrected_at = datetime.now(UTC)
    field.confidence = 1.0

    canonical = copy.deepcopy(document.canonical_data)
    try:
        _set_json_path(canonical, field.path, payload.normalized_value)
        validated_payload = SalesOrderPayload.model_validate(canonical)
        canonical = validated_payload.model_dump(mode="json")
        validation = validate_sales_order(
            validated_payload,
            expected_currency=document.stream.currency,
            config=document.stream.validation_config,
        )
        document.validation_summary = validation.summary()
        field.validation_status = validation.status_for(field.path)
        field.validation_messages = validation.messages_for(field.path)
    except (ValueError, TypeError) as exc:
        raise HTTPException(
            status_code=422, detail=f"Invalid value for {field.label}: {exc}"
        ) from exc
    document.canonical_data = canonical

    if document.review_task:
        document.review_task.status = "in_review"
        document.review_task.assigned_user_id = context.user.id
        document.review_task.started_at = document.review_task.started_at or datetime.now(UTC)
    document.status = "in_review"
    record_audit(
        db,
        organization_id=context.organization.id,
        actor_user_id=context.user.id,
        action="field.corrected",
        entity_type="document",
        entity_id=document.id,
        payload={"field_path": field.path, "before": before, "after": payload.normalized_value},
    )
    db.commit()
    return get_document(document_id, context, db)


