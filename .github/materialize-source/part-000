cat > .github/workflows/ci.yml <<'SOA_EOF_b803fcb7f17ed923'
name: CI

on:
  push:
    branches: [main, "agent/**", "phase-**"]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  backend:
    name: API, migrations, and smoke test
    runs-on: ubuntu-latest
    timeout-minutes: 20
    defaults:
      run:
        shell: bash
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: apps/api/pyproject.toml
      - name: Install backend
        run: python -m pip install --upgrade pip && pip install -e 'apps/api[dev]'
      - name: Lint and format check
        working-directory: apps/api
        run: |
          ruff check app tests alembic
          ruff format --check app tests alembic
      - name: Unit and API tests
        working-directory: apps/api
        run: pytest --cov=app --cov-report=term-missing --cov-fail-under=70
      - name: Verify database migrations
        working-directory: apps/api
        env:
          APP_ENV: development
          SECRET_KEY: ci-secret-key-with-more-than-thirty-two-characters
          DATABASE_URL: sqlite:///./data/migration-ci.db
        run: |
          mkdir -p data
          alembic upgrade head
          alembic check
          rm -f data/migration-ci.db
      - name: End-to-end local smoke test
        env:
          APP_ENV: development
          SECRET_KEY: ci-secret-key-with-more-than-thirty-two-characters
          DATABASE_URL: sqlite:///./apps/api/data/smoke-ci.db
          STORAGE_BACKEND: local
          LOCAL_STORAGE_PATH: ./apps/api/data/smoke-storage
          DEFAULT_LLM_PROVIDER: heuristic
          SEED_DEMO: "true"
          WORKER_POLL_SECONDS: "0.25"
        run: |
          cleanup() {
            kill "${API_PID:-}" "${WORKER_PID:-}" 2>/dev/null || true
            rm -rf apps/api/data/smoke-ci.db apps/api/data/smoke-storage
          }
          trap cleanup EXIT
          uvicorn app.main:app --app-dir apps/api --host 127.0.0.1 --port 8000 > /tmp/soa-api.log 2>&1 &
          API_PID=$!
          (cd apps/api && python -m app.worker) > /tmp/soa-worker.log 2>&1 &
          WORKER_PID=$!
          for attempt in {1..30}; do
            curl --fail --silent http://127.0.0.1:8000/health/ready && break
            sleep 1
          done
          python scripts/smoke_test.py

  frontend:
    name: Web typecheck, tests, and build
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: npm
          cache-dependency-path: apps/web/package-lock.json
      - name: Install frontend
        working-directory: apps/web
        run: npm ci
      - name: Typecheck
        working-directory: apps/web
        run: npm run typecheck
      - name: Unit tests
        working-directory: apps/web
        run: npm test -- --run
      - name: Production build
        working-directory: apps/web
        run: npm run build

  dependency-audit:
    name: Dependency audit
    runs-on: ubuntu-latest
    timeout-minutes: 10
    continue-on-error: true
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: npm
          cache-dependency-path: apps/web/package-lock.json
      - working-directory: apps/web
        run: npm ci && npm audit --audit-level=high
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: python -m pip install -e apps/api pip-audit && pip-audit
SOA_EOF_b803fcb7f17ed923

