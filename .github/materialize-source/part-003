from __future__ import annotations

import csv
import io

from fastapi import APIRouter, Depends, File, HTTPException, UploadFile, status
from sqlalchemy import func, select

from app.api.deps import Context, DbSession, RequestContext, require_role
from app.models import Catalog, CatalogRecord, Stream
from app.schemas import CatalogCreate, CatalogRead, CatalogRecordCreate, CatalogRecordRead
from app.services.audit import record_audit

router = APIRouter(prefix="/catalogs", tags=["catalogs"])


def _catalog_read(db: DbSession, catalog: Catalog) -> CatalogRead:
    response = CatalogRead.model_validate(catalog)
    response.record_count = (
        db.scalar(
            select(func.count(CatalogRecord.id)).where(CatalogRecord.catalog_id == catalog.id)
        )
        or 0
    )
    return response


def _get_catalog(db: DbSession, context: RequestContext, catalog_id: str) -> Catalog:
    catalog = db.get(Catalog, catalog_id)
    if not catalog or catalog.organization_id != context.organization.id:
        raise HTTPException(status_code=404, detail="Catalog not found")
    return catalog


@router.get("", response_model=list[CatalogRead])
def list_catalogs(context: Context, db: DbSession) -> list[CatalogRead]:
    catalogs = db.scalars(
        select(Catalog)
        .where(Catalog.organization_id == context.organization.id)
        .order_by(Catalog.name)
    ).all()
    return [_catalog_read(db, catalog) for catalog in catalogs]


@router.post("", response_model=CatalogRead, status_code=status.HTTP_201_CREATED)
def create_catalog(
    payload: CatalogCreate,
    db: DbSession,
    context: RequestContext = Depends(require_role("bucket_admin")),
) -> CatalogRead:
    if payload.stream_id:
        stream = db.get(Stream, payload.stream_id)
        if not stream or stream.organization_id != context.organization.id:
            raise HTTPException(status_code=404, detail="Stream not found")
    catalog = Catalog(organization_id=context.organization.id, **payload.model_dump())
    db.add(catalog)
