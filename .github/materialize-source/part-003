from __future__ import annotations

from collections import Counter, defaultdict
from datetime import UTC, datetime, timedelta

from fastapi import APIRouter
from sqlalchemy import func, select

from app.api.deps import Context, DbSession
from app.models import Document, ExtractionRun, ReviewTask, Stream
from app.schemas import DashboardMetrics, DocumentRead

router = APIRouter(prefix="/analytics", tags=["analytics"])


@router.get("/dashboard", response_model=DashboardMetrics)
def dashboard(context: Context, db: DbSession) -> DashboardMetrics:
    now = datetime.now(UTC)
    start_today = now.replace(hour=0, minute=0, second=0, microsecond=0)
    documents = db.scalars(
        select(Document)
        .where(Document.organization_id == context.organization.id)
        .order_by(Document.created_at.desc())
        .limit(5000)
    ).all()
    status_counts = Counter(document.status for document in documents)
    completed_statuses = {"approved", "exported", "completed"}

    auto_approved_ids = set(
        db.scalars(
            select(ReviewTask.document_id).where(
                ReviewTask.organization_id == context.organization.id,
                ReviewTask.status == "auto_approved",
            )
        )
    )
    completed_documents = [
        document for document in documents if document.status in completed_statuses
    ]
    straight_through_rate = (
        round(len(auto_approved_ids) / len(completed_documents) * 100, 1)
        if completed_documents
        else 0
    )
    confidences = [
        document.total_confidence for document in documents if document.total_confidence is not None
    ]

    runs = db.scalars(
        select(ExtractionRun)
        .where(ExtractionRun.organization_id == context.organization.id)
        .order_by(ExtractionRun.created_at.desc())
        .limit(5000)
    ).all()
    provider_counter = Counter(run.provider for run in runs)
    latency_values = [run.latency_ms for run in runs if run.latency_ms]

    volume: dict[str, int] = defaultdict(int)
    for offset in range(13, -1, -1):
        key = (now - timedelta(days=offset)).date().isoformat()
        volume[key] = 0
    for document in documents:
        key = document.created_at.date().isoformat()
        if key in volume:
            volume[key] += 1

    exception_statuses = {"failed", "needs_review", "in_review", "export_failed"}
    exceptions: list[DocumentRead] = []
    for document in documents:
        if document.status not in exception_statuses:
            continue
        item = DocumentRead.model_validate(document)
        item.stream_name = document.stream.name if document.stream else None
        item.review_status = document.review_task.status if document.review_task else None
        exceptions.append(item)
        if len(exceptions) >= 8:
            break

    active_streams = (
        db.scalar(
            select(func.count(Stream.id)).where(
                Stream.organization_id == context.organization.id,
                Stream.status == "active",
            )
        )
        or 0
    )
    return DashboardMetrics(
        total_documents=len(documents),
        documents_today=sum(document.created_at >= start_today for document in documents),
        processing=status_counts["processing"]
        + status_counts["queued"]
        + status_counts["received"],
        needs_review=status_counts["needs_review"] + status_counts["in_review"],
        completed=sum(status_counts[status] for status in completed_statuses),
        failed=status_counts["failed"] + status_counts["export_failed"],
        straight_through_rate=straight_through_rate,
        average_confidence=round(sum(confidences) / len(confidences) * 100, 1)
        if confidences
        else 0,
        average_processing_seconds=round(sum(latency_values) / len(latency_values) / 1000, 2)
        if latency_values
        else 0,
        active_streams=active_streams,
        provider_usage=[
            {"provider": provider, "documents": count}
            for provider, count in provider_counter.most_common()
        ],
        volume_by_day=[{"date": date, "documents": count} for date, count in volume.items()],
        status_breakdown=[
            {"status": status, "documents": count} for status, count in status_counts.most_common()
        ],
        recent_exceptions=exceptions,
    )
