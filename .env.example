# Local development environment. Copy to .env (make bootstrap does this).
# Every value here is a development default — production deployments provide
# real values through their secret manager, never through a committed file.

# --- Service environments ------------------------------------------------
SOA_API_ENVIRONMENT=development
SOA_WORKER_ENVIRONMENT=development

# Fail-fast rule: debug flags and the dev secret key below are rejected at
# startup when ENVIRONMENT=production.
SOA_API_DEBUG=false
SOA_WORKER_DEBUG=false

# --- Secrets (dev-only values) --------------------------------------------
# Outside development/test this key must be non-default and at least 32
# characters; domain-separated HMACs use it to pseudonymize rate-limit
# identities. Rotating it intentionally resets only the active 60-second
# limiter windows; stale digests then age out through bounded cleanup.
SOA_API_SECRET_KEY=dev-insecure-secret-key-do-not-use-in-production
# Enables the raw-MIME intake seam locally; production receives an independent
# 48-character value from Secret Manager.
SOA_API_EMAIL_INTAKE_SECRET=dev-email-intake-secret-do-not-use-in-production
# Raw-MIME intake defaults to 30 MiB (20 MiB decoded attachments), which fits
# the reference Cloud Run HTTP/1 request ceiling after MIME/base64 expansion.
# Alembic uses the unprefixed URL; deployed environments mount a dedicated
# schema-owner credential while API/worker use a DML-only application role.
SOA_DATABASE_URL=postgresql+psycopg://soa_dev:soa_dev_password@localhost:5432/soa
SOA_API_DATABASE_URL=postgresql+asyncpg://soa_app:soa_app_password@localhost:5432/soa
SOA_WORKER_DATABASE_URL=postgresql+asyncpg://soa_app:soa_app_password@localhost:5432/soa

# API and worker MUST share object storage. The default no-Docker profile uses
# local filesystem storage. To exercise MinIO/S3, change both backends to s3,
# uncomment the endpoint/credentials, and run `make local-up` first.
SOA_API_STORAGE_BACKEND=filesystem
SOA_API_STORAGE_BUCKET=soa-artifacts
SOA_WORKER_STORAGE_BACKEND=filesystem
SOA_WORKER_STORAGE_BUCKET=soa-artifacts
#SOA_API_STORAGE_ENDPOINT_URL=http://localhost:9000
#SOA_API_STORAGE_ACCESS_KEY=soa_dev
#SOA_API_STORAGE_SECRET_KEY=soa_dev_password
#SOA_WORKER_STORAGE_ENDPOINT_URL=http://localhost:9000
#SOA_WORKER_STORAGE_ACCESS_KEY=soa_dev
#SOA_WORKER_STORAGE_SECRET_KEY=soa_dev_password

# Extraction is selected by each published stream's immutable provider
# policy; there is no mutable deployment-wide "current provider" switch.
# Connection tests and delivery share this exact-host policy. Private and
# loopback DNS answers are still refused even when a host is listed.
SOA_API_OUTBOUND_DESTINATION_ALLOWLIST='["localhost","127.0.0.1"]'
SOA_WORKER_EXPORT_DESTINATION_ALLOWLIST='["localhost","127.0.0.1"]'

# Optional local OpenAI-compatible capability. Published stream policy selects
# it by registry name; these settings only register the adapter and bound each
# call. Increase the timeout only from measured target-hardware latency.
#SOA_WORKER_LOCAL_LLM_ENDPOINT=http://localhost:11434/v1/chat/completions
#SOA_WORKER_LOCAL_LLM_MODEL=qwen2.5:7b-instruct
#SOA_WORKER_LOCAL_LLM_TIMEOUT_SECONDS=60

# Hosted-model estimates use an explicit, versioned deployment rate card.
# These are static internal estimate pins, not live vendor prices. Whenever a
# hosted model or contract changes, update its reference and both integer-cent
# per-million-token rates together, then reconcile estimates to invoices.
#SOA_WORKER_ANTHROPIC_PRICING_REFERENCE=contract-2026q3:anthropic-sonnet
#SOA_WORKER_ANTHROPIC_INPUT_CENTS_PER_MILLION=300
#SOA_WORKER_ANTHROPIC_OUTPUT_CENTS_PER_MILLION=1500
#SOA_WORKER_GEMINI_PRICING_REFERENCE=contract-2026q3:gemini-flash
#SOA_WORKER_GEMINI_INPUT_CENTS_PER_MILLION=10
#SOA_WORKER_GEMINI_OUTPUT_CENTS_PER_MILLION=40
#SOA_WORKER_HOSTED_OPENAI_PRICING_REFERENCE=contract-2026q3:openai-compatible
#SOA_WORKER_HOSTED_OPENAI_INPUT_CENTS_PER_MILLION=250
#SOA_WORKER_HOSTED_OPENAI_OUTPUT_CENTS_PER_MILLION=1000

# --- Secret store (SEC-005) -------------------------------------------------
# Tenant-provided secret VALUES live behind this backend; the database keeps
# only secretref:// references. memory = lost on restart; file = persistent
# local development (point it OUTSIDE the repository); production must use
# a managed backend (GCP Secret Manager in the reference deployment, or AWS
# Secrets Manager) — production validation enforces this.
SOA_API_SECRETS_BACKEND=memory
SOA_WORKER_SECRETS_BACKEND=memory
#SOA_API_SECRETS_BACKEND=file
#SOA_API_SECRETS_DIRECTORY=~/.soa/dev-secrets

# --- Object storage (local dev) --------------------------------------------
# Filesystem object bytes go to .local-storage/ and the API serves signed
# upload/download URLs itself. `make dev` loads this file and supplies the
# browser origin below. Explicit shell exports override the dev-runner profile.
SOA_API_CORS_ALLOWED_ORIGINS='["http://localhost:5173"]'

# --- Web application -------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
# Leave VITE_AUTH_MODE unset for the local development identity. To exercise
# a real browser identity flow locally, explicitly select one mode and supply
# its public client configuration (never a client secret).
#VITE_AUTH_MODE=firebase
#VITE_FIREBASE_API_KEY=public-browser-api-key
#VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
#VITE_FIREBASE_PROJECT_ID=your-project
#VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
#VITE_FIREBASE_TENANT_ID=optional-identity-platform-tenant
#VITE_FIREBASE_PROVIDER_ID=oidc.enterprise
#VITE_FIREBASE_LOGIN_METHOD=redirect
# Generic OIDC + PKCE remains the provider-neutral alternative:
#VITE_AUTH_MODE=oidc
#VITE_OIDC_ISSUER=https://identity.example.com
#VITE_OIDC_CLIENT_ID=soa-web
#VITE_OIDC_SCOPE=openid profile email offline_access
#VITE_OIDC_AUDIENCE=soa-api
#VITE_OIDC_BEARER_TOKEN=id_token

# --- Local service ports (docker compose overrides) ------------------------
SOA_POSTGRES_PORT=5432
SOA_MINIO_PORT=9000
SOA_MINIO_CONSOLE_PORT=9001
SOA_MAILPIT_SMTP_PORT=1025
SOA_MAILPIT_UI_PORT=8025
SOA_CLAMAV_PORT=3310
SOA_OTLP_GRPC_PORT=4317
SOA_OTLP_HTTP_PORT=4318
SOA_GRAFANA_PORT=3000

# --- Application ports ------------------------------------------------------
SOA_API_PORT=8000
SOA_WEB_PORT=5173
