# Local development environment. Copy to .env (make bootstrap does this).
# Every value here is a development default — production deployments provide
# real values through their secret manager, never through a committed file.

# --- Service environments ------------------------------------------------
SOA_API_ENVIRONMENT=development
SOA_WORKER_ENVIRONMENT=development

# Fail-fast rule: debug flags and the dev secret key below are rejected at
# startup when ENVIRONMENT=production.
SOA_API_DEBUG=false
SOA_WORKER_DEBUG=false

# --- Secrets (dev-only values) --------------------------------------------
SOA_API_SECRET_KEY=dev-insecure-secret-key-do-not-use-in-production
SOA_API_DATABASE_URL=postgresql+asyncpg://soa_dev:soa_dev_password@localhost:5432/soa
SOA_WORKER_DATABASE_URL=postgresql+asyncpg://soa_dev:soa_dev_password@localhost:5432/soa

# --- Secret store (SEC-005) -------------------------------------------------
# Tenant-provided secret VALUES live behind this backend; the database keeps
# only secretref:// references. memory = lost on restart; file = persistent
# local development (point it OUTSIDE the repository); production must use
# aws-secrets-manager (+ SOA_API_SECRETS_AWS_REGION) — validation enforces it.
SOA_API_SECRETS_BACKEND=memory
SOA_WORKER_SECRETS_BACKEND=memory
#SOA_API_SECRETS_BACKEND=file
#SOA_API_SECRETS_DIRECTORY=~/.soa/dev-secrets

# --- Object storage (local dev) --------------------------------------------
# "filesystem" runs the whole stack with no MinIO/S3/Docker: object bytes go
# to .local-storage/ and the API serves signed upload/download URLs itself.
# The API and worker MUST agree. Use "s3" instead with `make local-up` (MinIO).
# These are read from the environment, not this file — export them (or use
# `make dev`, which prints the commands). See docs/LOCAL_DEV.md.
#   SOA_API_STORAGE_BACKEND=filesystem
#   SOA_WORKER_STORAGE_BACKEND=filesystem
#   SOA_API_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# --- Web application -------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# --- Local service ports (docker compose overrides) ------------------------
SOA_POSTGRES_PORT=5432
SOA_MINIO_PORT=9000
SOA_MINIO_CONSOLE_PORT=9001
SOA_MAILPIT_SMTP_PORT=1025
SOA_MAILPIT_UI_PORT=8025
SOA_CLAMAV_PORT=3310
SOA_OTLP_GRPC_PORT=4317
SOA_OTLP_HTTP_PORT=4318
SOA_GRAFANA_PORT=3000

# --- Application ports ------------------------------------------------------
SOA_API_PORT=8000
SOA_WEB_PORT=5173
